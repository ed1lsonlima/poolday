# Frontend (Vite)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon
VITE_MP_PUBLIC_KEY=sua-mp-public-key
# Endereço público único (canonical, og, sitemap, robots, retorno do login). Opcional: o padrão já é este.
VITE_SITE_URL=https://www.pooldaybr.com

# Backend (funções /api na Vercel) — NUNCA use prefixo VITE_ em segredos novos
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
MP_CLIENT_ID=seu-client-id-do-app-marketplace
MP_CLIENT_SECRET=seu-client-secret
# Precisa ser idêntico ao "Redirect URL" cadastrado no app do Mercado Pago.
MP_REDIRECT_URI=https://www.pooldaybr.com/api/mp-callback
MP_WEBHOOK_SECRET=assinatura-secreta-do-webhook-no-painel-mp
# Endereço público único para os retornos do Mercado Pago. Opcional: o padrão já é este.
SITE_URL=https://www.pooldaybr.com
